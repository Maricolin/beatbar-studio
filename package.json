{
  "name": "beatbar-studio",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "format": "prettier --write frontend scripts/*.mjs",
    "check": "node --check frontend/app.js && node --check frontend/visuals.js && prettier --check frontend scripts/*.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:visuals": "node scripts/visual-browser-test.mjs"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "agent-browser"
    ]
  },
  "devDependencies": {
    "agent-browser": "0.21.0",
    "prettier": "3.6.2"
  }
}
